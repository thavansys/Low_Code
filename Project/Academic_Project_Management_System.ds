 application "Academic Project Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form meeting_notes
		{
			displayname = "Meeting Notes"
			success message = "Notes Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			project
			(
				type = list	
				displayname = "Project"
				values  = project.ID
    			displayformat = [project_title]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			meeting_date
			(
    			type = datetime
				displayname = "Meeting Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			meeting_type
			(
				type = picklist
				displayname = "Meeting Type"
				values = {"Progress Review","Final Review","Team Meeting","Mentor Review"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			attendees
			(
				type = list	
				displayname = "Attendees"
				values  = student_profile.ID
    			displayformat = [full_name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			agenda
			(
    			type = textarea
				displayname = "Agenda"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			discussion_notes
			(
    			type = textarea
				displayname = "Discussion Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			decisions_made
			(
    			type = textarea
				displayname = "Decisions Made"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			action_items
			(
    			type = textarea
				displayname = "Action Items"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			next_meeting_date
			(
    			type = datetime
				displayname = "Next Meeting Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
