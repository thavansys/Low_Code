	reports
	{
		list task_Report
		{
			displayName = "All Tasks"
			show all rows from task    
			(
				task_title as "Task Title"
				project as "Project"
				task_description as "Task Description"
				assigned_student as "Assigned Student"
				created_date as "Created Date"
				start_date as "Start Date"
				due_date as "Due Date"
				task_status as "Task Status"
				priority as "Priority"
				completion_percentage as "Completion Percentage"
				(
					display = total,average,min,max	
				)
				estimated_hours as "Estimated Hours"
				actual_hours as "Actual Hours"
				blocker_description as "Blocker Description"
				task_attachment as "Task Attachment"
				mentor_comments as "Mentor Comments"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (task_status == "In Progress")
				fields = [task_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (task_status == "In Review")
				fields = [task_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (task_status == "To Do")
				fields = [task_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban task_by_task_status
		{
			displayName = "Task Statuses"
			show all rows from task    
			(
				task_title as "Task Title"
				project as "Project"
				task_description as "Task Description"
				assigned_student as "Assigned Student"
				created_date as "Created Date"
				start_date as "Start Date"
				due_date as "Due Date"
				task_status as "Task Status"
				priority as "Priority"
				completion_percentage as "Completion Percentage"
				(
					display = total,average,min,max	
				)
				estimated_hours as "Estimated Hours"
				actual_hours as "Actual Hours"
				blocker_description as "Blocker Description"
				task_attachment as "Task Attachment"
				mentor_comments as "Mentor Comments"
			)
