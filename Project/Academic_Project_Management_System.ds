					display = total,average,min,max	
				)
				work_completed as "Work Completed"
				next_steps as "Next Steps"
				challenges_faced as "Challenges Faced"
				help_required as "Help Required"
				supporting_file as "Supporting File"
			)
		}
		list meeting_notes_Report
		{
			displayName = "All Notes"
			show all rows from meeting_notes    
			(
				project as "Project"
				meeting_date as "Meeting Date"
				meeting_type as "Meeting Type"
				attendees as "Attendees"
				agenda as "Agenda"
				discussion_notes as "Discussion Notes"
				decisions_made as "Decisions Made"
				action_items as "Action Items"
				next_meeting_date as "Next Meeting Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (meeting_type == "Final Review")
				fields = [meeting_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (meeting_type == "Mentor Review")
				fields = [meeting_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban meeting_notes_by_meeting_type
		{
