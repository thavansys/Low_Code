		workflow
		{
		form
		{
			auto_assign_project_guide as "Auto-assign Project Guide"
			{
				type =  form
				form = project

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the logged-in user's email
										loggedInUserEmail = zoho.loginuserid;
										// Check if the project guide field is empty before setting it
										if(input.project_guide.isNull())
										{
											// Set the project guide to the logged-in user's email
											input.project_guide = loggedInUserEmail;
										}
						)
					}
				}

			}
			block_critical_task_submission as "Block Critical Task Submission"
			{
				type =  form
				form = task

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if the task priority is Critical
										if(input.priority == "Critical")
										{
											// Check if blocker description is empty or null
											if(input.blocker_description.isBlank())
											{
												// Display alert message to user
												alert "Critical tasks must have a blocker description. Please provide details before submitting.";
												// Cancel the form submission
												cancel submit;
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			weekly_project_deadline_reminder as "Weekly Project Deadline Reminder"
			{
				type =  schedule
				form = project
					status = inactive
				start = target_deadline at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch projects nearing their target deadline (within next 7 days)
										projectsNearingDeadline = project[target_deadline in next 7 days && target_deadline >= zoho.currentdate];
										// Check if there are any projects to notify about
										if(projectsNearingDeadline.count() > 0)
										{
											// Build email message with project details
											emailBody = "<h2>Projects Nearing Target Deadline</h2>";
											emailBody = emailBody.concat("<p>The following projects are approaching their target deadlines:</p>");
											emailBody = emailBody.concat("<ul>");
											for each  project in projectsNearingDeadline
											{
												projectTitle = project.project_title;
												targetDeadline = project.target_deadline;
												projectStatus = project.project_status;
												emailBody = emailBody.concat("<li>");
												emailBody = emailBody.concat("<strong>").concat(projectTitle).concat("</strong> - Deadline: ");
												emailBody = emailBody.concat(targetDeadline.toString("dd-MMM-yyyy")).concat(" (Status: ").concat(projectStatus).concat(")</li>");
											}
											emailBody = emailBody.concat("</ul>");
											emailBody = emailBody.concat("<p>Please ensure all deliverables are completed on time.</p>");
											// Send email to team
											sendmail
											[
												from :zoho.loginuserid
												to :zoho.loginuserid
												subject :"Weekly Reminder: Projects Nearing Target Deadline"
												message :emailBody
												content type :HTML
											]
										}
					)
					}
				}
			}
		}


