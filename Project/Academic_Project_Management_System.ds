		list progress_update_Report
		{
			displayName = "All Progress Updates"
			show all rows from progress_update    
			(
				project as "Project"
				related_task as "Related Task"
				updated_by as "Updated By"
				update_date as "Update Date"
				progress_percentage as "Progress Percentage"
